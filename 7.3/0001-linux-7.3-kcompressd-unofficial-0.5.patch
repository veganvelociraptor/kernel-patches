 /*
+ * do_swapout() - Write a folio to swap space
+ * @folio: The folio to write out
+ * @ctx: Reclaim batching context, or NULL to submit immediately
+ *
+ * Writes the folio to zswap or to the swap device. The folio is unlocked
+ * and its reference dropped before returning. A private context is used
+ * when the caller has none, and that context is submitted here so the bio
+ * cannot be left dangling on the stack.
+ */
+static void do_swapout(struct folio *folio, struct swap_io_ctx *ctx)
+{
+	struct swap_io_ctx local = {};
+	bool own_ctx = false;
+
+	if (!ctx) {
+		ctx = &local;
+		own_ctx = true;
+	}
+
+	if (zswap_store(folio)) {
+		count_mthp_stat(folio_order(folio), MTHP_STAT_ZSWPOUT);
+		folio_unlock(folio);
+	} else {
+		__swap_writepage(ctx, folio); /* Implies folio_unlock(folio) */
+		if (own_ctx)
+			swap_write_submit(ctx);
+	}
+
+	folio_put(folio);
+}
+
+/*
+ * kcompressd_store() - Off-load folio compression to kcompressd
+ * @folio: The folio to compress
+ * @ctx: Reclaim swap context, used if the queue is full and the oldest
+ *       folio has to be written out synchronously
+ *
+ * Only kswapd offloads anonymous folios. Returns true if the folio was
+ * queued (still locked; kcompressd unlocks it). Returns false to fall
+ * back to the synchronous swap_writeout() path.
+ */
+static bool kcompressd_store(struct folio *folio, struct swap_io_ctx *ctx)
+{
+	pg_data_t *pgdat = NODE_DATA(numa_node_id());
+	unsigned int ret = 0, sysctl_kcompressd = vm_kcompressd;
+	struct folio *head = NULL;
+
+	/* Only kswapd can use kcompressd */
+	if (!current_is_kswapd())
+		return false;
+
+	/* kcompressd must be enabled and running */
+	if (!sysctl_kcompressd || unlikely(!pgdat->kcompressd))
+		return false;
+
+	/* We can only off-load anon folios */
+	if (!folio_test_anon(folio))
+		return false;
+
+	/*
+	 * Fall back so swap_writeout() can return AOP_WRITEPAGE_ACTIVATE.
+	 * folio_memcg() requires an RCU read-side section.
+	 */
+	rcu_read_lock();
+	if (!mem_cgroup_zswap_writeback_enabled(folio_memcg(folio))) {
+		rcu_read_unlock();
+		return false;
+	}
+	rcu_read_unlock();
+
+	/* Swap device must be sync-efficient when zswap cannot absorb it */
+	if (!zswap_is_enabled() &&
+	    !data_race(__swap_entry_to_info(folio->swap)->flags & SWP_SYNCHRONOUS_IO))
+		return false;
+
+	/*
+	 * kcompressd sets PF_KSWAPD and may re-enter this path, so the fifo
+	 * has more than one writer. Hold the lock across the whole
+	 * dequeue-and-enqueue.
+	 */
+	folio_get(folio);
+	scoped_guard(spinlock_irqsave, &pgdat->kcompress_fifo_lock) {
+		if (kfifo_len(&pgdat->kcompress_fifo) >=
+		    sysctl_kcompressd * sizeof(folio) &&
+		    unlikely(!kfifo_out(&pgdat->kcompress_fifo, &head,
+					sizeof(folio)))) {
+			folio_put(folio);
+			return false;
+		}
+
+		if (kfifo_avail(&pgdat->kcompress_fifo) < sizeof(folio)) {
+			folio_put(folio);
+			ret = 0;
+		} else {
+			ret = kfifo_in(&pgdat->kcompress_fifo, &folio, sizeof(folio));
+		}
+	}
+
+	if (likely(ret))
+		wake_up_interruptible(&pgdat->kcompressd_wait);
+
+	/*
+	 * The oldest folio was dropped to make room. Write it out now,
+	 * batching into @ctx when the caller has one.
+	 */
+	if (head)
+		do_swapout(head, ctx);
+
+	return ret != 0;
+}
+
+/*
