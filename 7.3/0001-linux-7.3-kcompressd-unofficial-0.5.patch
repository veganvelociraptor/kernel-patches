+/*
+ * kcompressd() - Kernel thread for compressing folios
+ * @p: Pointer to pg_data_t structure
+ *
+ * Waits for folios queued by kcompressd_store() and writes them out.
+ * PF_MEMALLOC lets compression allocate under reclaim. PF_KSWAPD keeps
+ * the i915 shrinker off this thread. The thread is freezable so suspend
+ * does not race with swap IO, and the wait condition includes
+ * kthread_should_stop() so kswapd_stop() cannot hang.
+ */
+int kcompressd(void *p)
+{
+	pg_data_t *pgdat = (pg_data_t *)p;
+	struct folio *folio;
+
+	current->flags |= PF_MEMALLOC | PF_KSWAPD;
+	set_freezable();
+
+	while (!kthread_should_stop()) {
+		wait_event_freezable(pgdat->kcompressd_wait,
+				!kfifo_is_empty(&pgdat->kcompress_fifo) ||
+				kthread_should_stop());
+
+		while (kfifo_out_locked(&pgdat->kcompress_fifo,
+				&folio, sizeof(folio),
+				&pgdat->kcompress_fifo_lock))
+			do_swapout(folio, NULL);
+	}
+
+	/* kswapd is already stopped; drain anything queued behind us. */
+	while (kfifo_out_locked(&pgdat->kcompress_fifo,
+			&folio, sizeof(folio), &pgdat->kcompress_fifo_lock))
+		do_swapout(folio, NULL);
+
+	return 0;
+}
